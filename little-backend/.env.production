# Postgres connection string (Prisma format)
DATABASE_URL="postgresql://user:password@localhost:5432/little_log?schema=public"

# Server
PORT=4001
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Claude API (agenda vision parsing)
ANTHROPIC_API_KEY="sk-ant-..."

# File storage for uploaded agenda photos.
# For local dev, images are written to ./uploads and served from /uploads.
# In production, point this at your S3/Azure Blob base URL instead and
# swap the storage in src/services/storage.service.ts.
PUBLIC_UPLOADS_BASE_URL="http://localhost:4001/uploads"

# RevenueCat webhook shared secret (validates incoming webhook calls)
REVENUECAT_WEBHOOK_SECRET="change-me-webhook"

# CORS
CORS_ORIGIN="*"
